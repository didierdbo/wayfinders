<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Wayfinders.Client.Tests</RootNamespace>
    <!-- We do NOT ProjectReference the Godot client csproj. It uses the
         Godot.NET.Sdk and a ProjectReference would drag GodotSharp + the
         engine binding into a plain test host that has no Godot runtime.
         Instead, we cherry-pick the Godot-free source files via
         <Compile Include> below. Cleaner, faster, AOT-friendly. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- Same versions as the client csproj. Pinned so test parity matches
         what production runs on. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Compile the ML source files directly into the test assembly.
       IClassifier, MiniLmEncoder, ResolutionHead, and OnnxClassifier all
       have no Godot dependency by design (the Godot bridge lives in
       ClassifierService, which we deliberately do not test from xUnit; it
       would require a live Godot runtime, see L4 brief §5.3). -->
  <ItemGroup>
    <Compile Include="..\ml\IClassifier.cs" Link="src\IClassifier.cs" />
    <Compile Include="..\ml\MiniLmEncoder.cs" Link="src\MiniLmEncoder.cs" />
    <Compile Include="..\ml\ResolutionHead.cs" Link="src\ResolutionHead.cs" />
    <Compile Include="..\ml\OnnxClassifier.cs" Link="src\OnnxClassifier.cs" />
  </ItemGroup>

  <!-- Phase 7 J1: Opening Scenario scaffold pure-C# pieces.
       NavigationStack and AssetKeyMap are deliberately Godot-free so the
       host xUnit assembly can exercise them without the engine. The
       Godot-bound services (SceneManager, AssetResolver, GameState) live
       in the client csproj only and are validated via the J1 manual
       integration checklist, not xUnit (would require a Godot runtime;
       same rationale as ClassifierService at L4). -->
  <ItemGroup>
    <Compile Include="..\services\NavigationStack.cs" Link="src\NavigationStack.cs" />
    <Compile Include="..\services\AssetKeyMap.cs" Link="src\AssetKeyMap.cs" />
    <Compile Include="..\services\AssetKeyResolverLogic.cs" Link="src\AssetKeyResolverLogic.cs" />
    <Compile Include="..\scripts\screens\IScreen.cs" Link="src\IScreen.cs" />
    <Compile Include="..\scripts\screens\IModalOverlay.cs" Link="src\IModalOverlay.cs" />
    <Compile Include="..\scripts\screens\ScreenContext.cs" Link="src\ScreenContext.cs" />
    <Compile Include="..\scripts\screens\NavigationRequest.cs" Link="src\NavigationRequest.cs" />
    <Compile Include="..\scripts\screens\ContinueGatingLogic.cs" Link="src\ContinueGatingLogic.cs" />
    <!-- Phase 9 J4 hotfix (2026-05-09 evening): boot-action decision rule
         for the OpeningBootstrap autoload. The autoload itself depends on
         Godot (Node, GetTree, GetNode) so xUnit pins the pure decision
         (skip / register-only / register-and-boot) at the seam. Catches
         any future regression that drops the F6-launch RegisterOnly branch
         and re-introduces the J4 double-spawn. -->
    <Compile Include="..\scripts\screens\OpeningBootstrapLogic.cs" Link="src\OpeningBootstrapLogic.cs" />
  </ItemGroup>

  <!-- Phase 7 J3: E2 World Map POI dispatch logic (pure-C#). The DTO and
       dispatcher are Godot-free so xUnit pins the Halfgate-only gate
       (Varn §6.D6.10) without spinning up an engine. The Godot-side
       PoiDefinition / WorldMapPois Resources are exercised via the J3
       manual integration checklist. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\PoiDefinitionDto.cs" Link="src\PoiDefinitionDto.cs" />
    <Compile Include="..\scripts\screens\PoiDispatchLogic.cs" Link="src\PoiDispatchLogic.cs" />
  </ItemGroup>

  <!-- Phase 7 J5: NPC catalog (pure-C# data + lookup helpers). The Godot
       autoload NpcRegistry wraps this static catalog so xUnit pins the
       contract (display name, portrait key composition, fiche number)
       without a Godot runtime. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\NpcCatalog.cs" Link="src\NpcCatalog.cs" />
  </ItemGroup>

  <!-- Phase 8 P8.1 (M3): layer ladder resolution helper. Pure-C#, Godot-free
       so xUnit pins the monde / cité / quartier ladder semantics. The
       Godot-bound wheel input handler + NavigateLadderUp/Down verbs live
       in SceneManager and are validated through the P8.1 manual checklist
       and the LadderInputContractTests fake harness (same pattern as
       E1NavigationContractTests). -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\LadderResolutionLogic.cs" Link="src\LadderResolutionLogic.cs" />
  </ItemGroup>

  <!-- Phase 8 P8.2 (M3): scroll/pan camera helper for E2 World Map.
       Pure-C#, Godot-free so xUnit pins the clamp / diagonal-normalise /
       advance-by-delta contract independent of Godot's runtime
       Camera2D.LimitLeft/Top/Right/Bottom (which actually applies the
       clamp at runtime). The Godot-bound drag-pan + ZQSD wiring lives
       in E2WorldMap.cs and is validated via the P8.2 manual checklist
       (10 steps). -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\CameraPanLogic.cs" Link="src\CameraPanLogic.cs" />
  </ItemGroup>

  <!-- Phase 8 P8.3 (M3): map pan config + drag threshold pure-C#
       seam. MapPanInputLogic is the state machine (Idle / Tracking /
       Dragging) wired by E2WorldMap ; MapPanButton is the typed enum
       persisted via GameSettingsStore. The store + IConfigBackend
       interface live in services/ but are Godot-free by design so
       xUnit pins the persistence policy (load defaults, malformed
       fallback, idempotent writes) without an engine. The Godot-bound
       GameSettings autoload + GodotConfigFileBackend stay in the
       client csproj only and are validated via the P8.3 manual
       checklist (12 steps). -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\MapPanButton.cs" Link="src\MapPanButton.cs" />
    <Compile Include="..\scripts\screens\MapPanInputLogic.cs" Link="src\MapPanInputLogic.cs" />
    <Compile Include="..\services\GameSettingsStore.cs" Link="src\GameSettingsStore.cs" />
  </ItemGroup>

  <!-- Phase 9 slice 1 (M3 / L1 World fondations / 2026-05-08): tile
       knowledge spectrum + fog grid math. Both helpers Godot-free by
       design so xUnit pins the cell-to-world mapping (renderer + bake
       must agree) and the five-level enum's persistence integers
       (renumbering would silently corrupt save files). The Godot-bound
       FogTileLayer renderer + TileKnowledgeStore autoload + Editor
       PaletteQuantizerTool stay in the client csproj only — they are
       validated through manual integration (debug F-key toggle for the
       store, editor "Run Bake Now" toggle for the tool). -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\TileKnowledgeState.cs" Link="src\TileKnowledgeState.cs" />
    <Compile Include="..\scripts\screens\FogTileGridLogic.cs" Link="src\FogTileGridLogic.cs" />
  </ItemGroup>

  <!-- Phase 9 slice 2 (M3 / L1 World fondations / 2026-05-08): palette
       source contract. IFogPaletteSource + PaletteRgb are Godot-free
       so xUnit pins the array-of-3 contract and the neutral-carton
       fallback shape. The Godot-bound BakedFogPaletteSource (reads the
       baked PNG via ResourceLoader) stays in the client csproj only —
       fallback codepath validated through manual smoke (delete the
       PNG, observe neutral-carton swatches). -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\IFogPaletteSource.cs" Link="src\IFogPaletteSource.cs" />
  </ItemGroup>

  <!-- Phase 9 slice 3 (M3 / L1 World drill zoom-driven / 2026-05-08): zoom
       navigation decision helper. ZoomNavLogic is Godot-free so xUnit pins
       the threshold + hysteresis + debounce + tile-knowledge-gate contract
       (six branches: continuous zoom, drill candidate, drill blocked,
       climb candidate, debounced, none). The runtime MapPan2DComponent
       slice 3 wiring (Camera2D.Zoom tween, cursor-centred zoom, signal
       emit to E2WorldMap for SceneManager.NavigateTo) stays in the client
       csproj only and is exercised through manual integration. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\ZoomNavLogic.cs" Link="src\ZoomNavLogic.cs" />
  </ItemGroup>

  <!-- Phase 9 J5 (post-J4 hotfix / 2026-05-09 evening): pan watchdog
       state machine. Pure-C# decision helper for the frozen-camera and
       stuck-transition watchdogs introduced after J4 surfaced two pan
       regressions. Engine reads (Camera2D.Position, Time.GetTicksMsec)
       stay in MapPan2DComponent ; the rules live here. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\PanWatchdogLogic.cs" Link="src\PanWatchdogLogic.cs" />
  </ItemGroup>

  <!-- Phase 9 slice 3.5 (M3 / L1 World iso refactor / 2026-05-08): per-tile
       bitmap registry. CellBitmapRegistry<T> is the pure-C# type that pins
       the set/clear/replace/no-leak contract for the slice 3.5 livrable 4
       per-tile bitmap API. The runtime FogTileLayer types it on Godot.Texture2D
       and uses it (or rather mirrors the same semantics directly via
       Polygon2D.Texture); the seam stays Godot-free for xUnit. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\CellBitmapRegistry.cs" Link="src\CellBitmapRegistry.cs" />
  </ItemGroup>

  <!-- Phase 9 J5+ (Compagnie panel probe / 2026-05-09 nuit): UI panel
       slide state machine + drag-drop NPC autonomy invariant + auto-rabat
       dispatch contract. Pure-C# so xUnit pins the state transitions and
       the AssignToMissionEvent shape ; the runtime CompagniePanelProbe
       owns the SubViewport + Camera2D/Camera3D pair + Tween3D + signals,
       validated by the canary self-check at _Ready (Pattern J). -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\CompagniePanelLogic.cs" Link="src\CompagniePanelLogic.cs" />
  </ItemGroup>

  <!-- M1 mission-emergence (etape 4a / 2026-05-10): wire-format DTOs
       for POST /api/world/tick + the source-gen JSON context that
       handles them. Both files Godot-free by design (records +
       JsonSerializerContext only) so xUnit pins the closed-lookup
       constants (Varn-locked 2026-05-10), the snake_case naming
       policy, and the null-mission-on-no-emergence path. The
       Godot-bound ApiClient.TickAsync autoload method itself is
       not xUnit-tested. Same rationale as GetUnitsAsync and
       ClassifierService : Godot runtime not spun up in the test host,
       end-to-end validated against a live uvicorn at etape 4d. -->
  <ItemGroup>
    <Compile Include="..\services\Dtos\UnitDto.cs" Link="src\UnitDto.cs" />
    <Compile Include="..\services\Dtos\ApiJsonContext.cs" Link="src\ApiJsonContext.cs" />
    <Compile Include="..\services\Dtos\WorldTickDtos.cs" Link="src\WorldTickDtos.cs" />
  </ItemGroup>

  <!-- M1 mission-emergence (etape 4b / 2026-05-10): full CharacterState
       mirror + mission resolution wire types + cadence helper. All
       Godot-free by design (records + JsonSerializerContext +
       pure-C# accumulator) so xUnit pins the round-trip + closed
       lookups + cadence math. The Godot-bound WorldSimTick autoload
       and the ApiClient.ResolveMissionAsync method itself are
       end-to-end validated against a live uvicorn at etape 4d. -->
  <ItemGroup>
    <Compile Include="..\services\Dtos\CharacterStateDto.cs" Link="src\CharacterStateDto.cs" />
    <Compile Include="..\services\Dtos\MissionResolveDtos.cs" Link="src\MissionResolveDtos.cs" />
    <Compile Include="..\services\WorldSimTickCadence.cs" Link="src\WorldSimTickCadence.cs" />
  </ItemGroup>

  <!-- M1 mission-emergence (etape 4c / 2026-05-10): MissionPanelLogic
       pure-C# decision helper for the M1 text-only Mission panel
       (Affect / Decliner button states, resolve request build, status
       text format). Godot-bound MissionPanelProbe wires Buttons +
       Labels + the async ApiClient.ResolveMissionAsync call ; xUnit
       pins the contract here. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\MissionPanelLogic.cs" Link="src\MissionPanelLogic.cs" />
  </ItemGroup>

  <!-- M1 slice 5ab (composite Compagnie + Mission scene / 2026-05-10):
       M1SliceLogic decision helper for the cross-panel drag-drop
       (Pattern P5), the auto-rabat lock (Pattern P6, Mission stays
       fixed and never broadcasts), and the screen-rect hit test.
       Godot-bound M1Slice scene wires SubViewportContainers + golden
       2D proxy + signals ; xUnit pins the decision table here. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\M1SliceLogic.cs" Link="src\M1SliceLogic.cs" />
  </ItemGroup>

  <!-- M2-advance step 2 (mission duration + server-authority outcome
       roll / 2026-05-10): MissionConcludeDtos for the new
       POST /api/world/mission/conclude wire, plus MissionDurationLogic
       for the pure-C# active-mission state (countdown suffix,
       persona-busy lookup, conclude-request projection from
       CharacterStateDto). The Godot-bound ActiveMissions slot on
       GameState + the WorldSimTick countdown loop are scene-tree
       runtime ; xUnit pins the data-flow contracts here. -->
  <ItemGroup>
    <Compile Include="..\services\Dtos\MissionConcludeDtos.cs" Link="src\MissionConcludeDtos.cs" />
    <Compile Include="..\scripts\screens\MissionDurationLogic.cs" Link="src\MissionDurationLogic.cs" />
  </ItemGroup>

  <!-- PR4 POI input router (2026-05-15): pure-C# bitmap hit-test helper.
       The Godot-bound PoiInputRouter autoload owns the input cascade
       (mouse position, viewport, Y-sort, SetInputAsHandled, signal emit) ;
       the pixel-level decision lives in PoiHitTestLogic and is pinned
       here. Same separation pattern as PoiDispatchLogic + PoiDefinition,
       NpcCatalog + NpcRegistry, MissionPanelLogic + MissionPanelProbe. -->
  <ItemGroup>
    <Compile Include="..\scripts\poi\PoiHitTestLogic.cs" Link="src\PoiHitTestLogic.cs" />
  </ItemGroup>

  <!-- Mission tooltip Pattern B (Varn-lock 2026-05-15 v2 §2): pure-C#
       row formatter + filter + sort + cap helper for the
       "Affaires en cours" tooltip section. Godot-bound rendering
       lives in IsoMapE1Probe ; xUnit pins the row format (glyph map,
       3-niveaux difficulty projection, 38-char truncation), the
       prefix-match filter via the injected predicate, the FIFO sort
       by Id, and the cap = 3. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\MissionTooltipRowLogic.cs" Link="src\MissionTooltipRowLogic.cs" />
  </ItemGroup>

  <!-- PR5 POI "pion sur plateau" pure-C# helpers (2026-05-15): lift clamp
       window [0,3] + parallax strength clamp window [0, 0.05] + parallax
       offset formula. The Godot-bound shader uniform set, the Sprite2D
       Shadow attach, and the per-frame camera read live in Poi.cs ; the
       four locked windows (memo project_wayfinders_pion_sur_plateau) are
       pinned here so a slipped inspector value or a probe typo cannot
       ship the "jouet" anti-pattern. -->
  <ItemGroup>
    <Compile Include="..\scripts\poi\PoiVisualLogic.cs" Link="src\PoiVisualLogic.cs" />
  </ItemGroup>

  <!-- Tile reveal shader pure-C# state holder (Varn spec
       varn-tile-reveal-shader-spec-2026-05-15.md, locked 2026-05-15).
       Owns the per-tile reveal_level matrix + R8 byte encoding seam
       between IsoMapE1Probe (writes) and tile_reveal.gdshader (reads
       via the ImageTexture sample). xUnit pins the locked constants
       (GridSize=64, DefaultFeatherWidth=0.30), the clamp policy
       (saturate NaN / out-of-range), and the round(value × 255)
       encoding contract. The Godot-bound Image / ImageTexture /
       ShaderMaterial wiring stays in IsoMapE1Probe.InitRevealShaderState
       and is validated via F5 visual smoke. -->
  <ItemGroup>
    <Compile Include="..\scripts\screens\TileRevealStateLogic.cs" Link="src\TileRevealStateLogic.cs" />
  </ItemGroup>

</Project>
