; PR6 POI manifest entries. Designer-authored : edit these via the
; Godot inspector (M1Slice root -> PoisToSpawn array) to add / move POIs.
; See client/data/POI_INTEGRATION.md for the full pattern.
[sub_resource type="Resource" id="PoiEntry_halfgate"]
script = ExtResource("3_poispne")
Tile = Vector2i(12, 12)
SidecarPngPath = "res://assets/poi/e1/wf_e1_halfgate_poi.png"
DisplayNameOverride = ""

; PR6 - second POI proving the pattern is repeatable. MVP : same asset,
; different tile, distinct DisplayName. When Mira ships a second clean
; POI asset, swap SidecarPngPath here ; no other edit needed.
[sub_resource type="Resource" id="PoiEntry_halfgate_annex"]
script = ExtResource("3_poispne")
Tile = Vector2i(14, 13)
SidecarPngPath = "res://assets/poi/e1/wf_e1_halfgate_poi.png"
DisplayNameOverride = "HalfgateAnnex"


[node name="M1Slice" type="Node2D"]
script = ExtResource("1_m1slice")
PoisToSpawn = Array[Resource]([SubResource("PoiEntry_halfgate"), SubResource("PoiEntry_halfgate_annex")])
PoiSpawnerPath = NodePath("PoiSpawner")
PoiClickNavigateTo = "E2_AREA"
metadata/skip_opening_bootstrap = true

; PR6 - POI spawner child. Stateless ; per-scene lifetime (locked memo
; project_wayfinders_poi_integration_pattern). Not an autoload by design.
[node name="PoiSpawner" type="Node" parent="."]
script = ExtResource("2_poispwn")

[node name="Background2D" type="CanvasLayer" parent="."]
layer = -10

[node name="BgRect" type="ColorRect" parent="Background2D"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.05, 0.06, 1)
mouse_filter = 2

; ====================================================================
; CompagnieRoot : SubViewportContainer + SubViewport sub-iso scene
; (Pattern P1) and the diegetic handle.
; ====================================================================

[node name="CompagnieRoot" type="CanvasLayer" parent="."]
layer = 0

[node name="SubViewportContainer" type="SubViewportContainer" parent="CompagnieRoot"]
position = Vector2(-560, 80)
size = Vector2(560, 720)
stretch = true
mouse_filter = 0

[node name="SubViewport" type="SubViewport" parent="CompagnieRoot/SubViewportContainer"]
own_world_3d = true
handle_input_locally = true
physics_object_picking = true
size = Vector2i(560, 720)
render_target_update_mode = 4

[node name="WorldEnvironment3D" type="WorldEnvironment" parent="CompagnieRoot/SubViewportContainer/SubViewport"]
