; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wayfinders"
run/main_scene="res://scenes/screens/E1Title.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ApiClient="*res://services/ApiClient.tscn"
Classifier="*res://ml/ClassifierService.tscn"
SceneManager="*res://services/SceneManager.tscn"
AssetResolver="*res://services/AssetResolver.tscn"
GameState="*res://services/GameState.tscn"
KnowledgeMatrix="*res://services/KnowledgeMatrix.tscn"
OnboardingPops="*res://services/OnboardingPops.tscn"
HoverTooltipController="*res://services/HoverTooltipController.tscn"
NpcRegistry="*res://services/NpcRegistry.tscn"
WorldSimTick="*res://services/WorldSimTick.tscn"
GameSettings="*res://services/GameSettings.tscn"
OpeningBootstrap="*res://services/OpeningBootstrap.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Wayfinders.Client"

[gui]

theme/custom="res://themes/wayfinders_default.tres"

